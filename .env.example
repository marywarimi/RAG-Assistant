# NVIDIA API Configuration
# 1. Sign up at https://build.nvidia.com/ to get your free API key
NVIDIA_API_KEY=your_nvidia_api_key_here

# 2. Enter your chosen NVIDIA models below (leave blank or fill with your selection from build.nvidia.com):
# Example embedding model: nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_EMBED_MODEL=

# Example reranking model: nvidia/llama-3.2-nv-rerankqa-1b-v2
NVIDIA_RERANK_MODEL=

# Example chat model: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_LLM_MODEL=
